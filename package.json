{
  "name": "bettercallclaude-mcp-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "Monorepo of Model Context Protocol (MCP) servers for Swiss legal research — BGE, entscheidsuche, legal citations, legal persona tools, and TAS/CAS jurisprudence.",
  "license": "MIT",
  "author": "BetterCallClaude",
  "workspaces": [
    "mcp-servers/bge-search",
    "mcp-servers/entscheidsuche",
    "mcp-servers/legal-citations",
    "mcp-servers/legal-persona",
    "mcp-servers/tas-jurisprudence"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf mcp-servers/*/dist mcp-servers/*/node_modules node_modules"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fedec65/BetterCallClaudeMCP.git"
  }
}
